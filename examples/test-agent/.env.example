# Verora test agents. Copy to .env and fill in; never commit real keys.

# "production" makes every agent's encryption key mandatory (no random development keys)
NODE_ENV=production

# HTTP port (Coolify: expose this port)
PORT=4102

# Chain: sepolia, or foundry / anvil for a local Anvil node
CHAIN=sepolia

# JSON-RPC endpoint for CHAIN (required on sepolia; defaults to http://localhost:8545 on local chains)
RPC_URL=

# Contract addresses: set both addresses, or DEPLOYMENT, not both.
QUERY_CONSUMER_ADDRESS=
AGENT_REGISTRY_ADDRESS=
# Path to a deployment manifest (verora-contracts/deployments/<chainId>.json) inside the container
# DEPLOYMENT=

# Comma-separated agent slugs. Each slug answers at https://<host>/<slug>/query
TEST_AGENTS=alpha,beta,gamma

# Per agent: AGENT_<SLUG>_OWNER_KEY and AGENT_<SLUG>_ENCRYPTION_SECRET_KEY
# (slug uppercased, "-" becomes "_"). Each owner key is the 0x-prefixed private key of the wallet that
# registered that agent; keys must be distinct, and public Anvil keys are refused on non-local chains.
# Encryption secret keys are base64 of 32 random bytes: openssl rand -base64 32
AGENT_ALPHA_OWNER_KEY=
AGENT_ALPHA_ENCRYPTION_SECRET_KEY=
AGENT_BETA_OWNER_KEY=
AGENT_BETA_ENCRYPTION_SECRET_KEY=
AGENT_GAMMA_OWNER_KEY=
AGENT_GAMMA_ENCRYPTION_SECRET_KEY=

# Reverse proxy hops to trust for the client IP used by rate limiting (Coolify/Traefik: 1)
TRUST_PROXY=1

# Per-IP token bucket: burst size and sustained requests per minute
RATE_LIMIT_BURST=30
RATE_LIMIT_PER_MINUTE=60

# How long agent owner lookups from the AgentRegistry are cached
OWNER_CACHE_TTL_SECONDS=300
