{
  "name": "@verora/sdk",
  "version": "0.1.0",
  "author": "Berke (pzzaworks)",
  "description": "TypeScript SDK for Verora, the decentralized AI oracle network: send paid, optionally end-to-end encrypted queries to AI agents on-chain, or build and run an agent.",
  "license": "MIT",
  "keywords": [
    "verora",
    "oracle",
    "ai",
    "ai-agents",
    "agents",
    "ethereum",
    "sepolia",
    "eip-712",
    "e2e-encryption",
    "web3",
    "viem"
  ],
  "homepage": "https://github.com/pzzaworks/verora-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pzzaworks/verora-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/pzzaworks/verora-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "example:full-flow": "tsx examples/full-flow.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "peerDependencies": {
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^9.26.0",
    "eslint-plugin-security": "^3.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "viem": "^2.47.2",
    "vitest": "^3.1.3"
  },
  "packageManager": "pnpm@10.12.3"
}
